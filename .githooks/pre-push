#!/usr/bin/env bash
# Everything too slow to run on every commit lives here.
#
# pre-commit limits itself to goimports + gofmt so that `git commit` — and every
# `git commit --amend` and interactive rebase step on top of it — stays
# interactive. This hook runs the checks that actually decide whether the branch
# is publishable, and `pre-commit` points here rather than duplicating them.
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

has_doc_changes=0
while IFS= read -r path; do
  [[ -z "$path" ]] && continue
  case "$path" in
    *.md|*.markdown|docs/*|website/*|scripts/check-docs.py|scripts/sync-docs.mjs|.github/workflows/docs.yml)
      has_doc_changes=1
      break
      ;;
  esac
done < <(git diff --name-only @{push}...HEAD 2>/dev/null || git diff --name-only HEAD~1...HEAD)

# Commits created with --no-verify or from a clone without core.hooksPath
# configured would otherwise push unformatted Go. preflight's fmt-check reports
# the files; this guard only turns a missing tool into a clear message.
if ! command -v goimports >/dev/null 2>&1; then
  echo "pre-push: goimports not found in PATH" >&2
  echo "install with: go install golang.org/x/tools/cmd/goimports@latest" >&2
  exit 1
fi

# preflight runs formatting, module tidiness, vet, staticcheck and the short
# test suite. The coverage floor, `go test -race` and gopls diagnostics belong
# to CI's test, race and gopls jobs; `make quality` and `make gopls-check`
# reproduce them locally. The cross-repo contract gate is not part of preflight
# either: that script only reports whether a Chord checkout is available, so run
# ./scripts/check-chord-contract.sh (or `make contract`) explicitly when a
# checkout is present.
echo "pre-push: running preflight"
make preflight

if [[ "$has_doc_changes" -eq 1 ]]; then
  echo "pre-push: running docs checks"
  python3 scripts/check-docs.py
fi
